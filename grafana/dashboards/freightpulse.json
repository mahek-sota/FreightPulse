      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(consumer_lag{topic=~\".*(shipment.events|telemetry.gps)\"})",
          "instant": false
